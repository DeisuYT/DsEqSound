+
+FilterTable* MainWindow::currentFilterTable() const {
+    auto* scroll=qobject_cast<QScrollArea*>(ui->tabWidget->currentWidget());
+    return scroll?qobject_cast<FilterTable*>(scroll->widget()):nullptr;
+}
+
+void MainWindow::setupStudioWorkspace() {
+    setWindowTitle(QStringLiteral("DEISU Audio — Equalizer APO"));
+    auto* dock=new QDockWidget(tr("Audio workspace"),this);
+    dock->setObjectName("deisuStudioDock");
+    dock->setFeatures(QDockWidget::NoDockWidgetFeatures);
+    auto* panel=new QWidget(dock);panel->setObjectName("studioSidebar");
+    panel->setMinimumWidth(230);panel->setMaximumWidth(310);
+    auto* layout=new QVBoxLayout(panel);layout->setContentsMargins(18,22,18,18);layout->setSpacing(12);
+    auto* brand=new QLabel(QStringLiteral("DEISU AUDIO"),panel);brand->setObjectName("studioBrand");layout->addWidget(brand);
+    auto* subtitle=new QLabel(tr("Effects • Live panels • Backups"),panel);subtitle->setObjectName("studioSubtitle");subtitle->setWordWrap(true);layout->addWidget(subtitle);
+    auto* title=new QLabel(tr("Editing device"),panel);layout->addWidget(title);
+    auto* device=new QLabel(deviceComboBox->currentText(),panel);device->setWordWrap(true);layout->addWidget(device);
+    connect(deviceComboBox,&QComboBox::currentTextChanged,device,&QLabel::setText);
+    auto* hint=new QLabel(tr("The selector previews a device. Use a Device filter to restrict where a chain runs."),panel);hint->setWordWrap(true);layout->addWidget(hint);
+    auto addButton=[&](const QString& name,const QString& line) {
+        auto* button=new QPushButton(name,panel);layout->addWidget(button);
+        connect(button,&QPushButton::clicked,this,[this,line]() {
+            auto* table=currentFilterTable();
+            if(!table) {on_actionNew_triggered();table=currentFilterTable();}
+            if(!table)return;
+            table->addLine(line.contains("%1") ? line.arg(QUuid::createUuid().toString(QUuid::WithoutBraces)) : line);
+            table->updateGuis();
+        });
+        return button;
+    };
+    addButton(tr("+ VST2 / VST3 effect"),QStringLiteral("VSTPlugin:"))->setObjectName("studioPrimary");
+    addButton(tr("+ Live level meter"),QStringLiteral("VUMeter: MeterId %1 Channels all RMS \"AES17\" LUFS \"ITU-R BS.1770-5\""));
+    addButton(tr("+ Gain control"),QStringLiteral("Preamp: 0 dB"));
+    auto* liveHelp=new QLabel(tr("Open panel on an effect to see its live display. Add meters before and after effects to compare levels. Save the active chain to apply it."),panel);
+    liveHelp->setWordWrap(true);layout->addWidget(liveHelp);
+    auto* latencyHelp=new QLabel(tr("Each VST has an Audio buffer selector. Smaller buffers can reduce transport delay; larger buffers tolerate heavier effects. This is not an end-to-end latency measurement."),panel);
+    latencyHelp->setWordWrap(true);layout->addWidget(latencyHelp);
+    layout->addStretch();
+    auto* saveButton=new QPushButton(tr("Save backup…"),panel);layout->addWidget(saveButton);
+    connect(saveButton,&QPushButton::clicked,this,&MainWindow::saveStudioBackup);
+    auto* restoreButton=new QPushButton(tr("Restore backup…"),panel);layout->addWidget(restoreButton);
+    connect(restoreButton,&QPushButton::clicked,this,&MainWindow::restoreStudioBackup);
+    auto* backupHelp=new QLabel(tr("One file: configuration folder and plug-in states stored there. External files, installed plug-ins and licenses are not included."),panel);
+    backupHelp->setWordWrap(true);layout->addWidget(backupHelp);
+    auto* theme=new QCheckBox(tr("Dark workspace"),panel);layout->addWidget(theme);
+    QSettings settings("DEISU","Audio");theme->setChecked(settings.value("dark",true).toBool());
+    auto applyTheme=[this](bool dark) {setStyleSheet(dark?deisuStudioStyle():QString());QSettings("DEISU","Audio").setValue("dark",dark);};
+    applyTheme(theme->isChecked());connect(theme,&QCheckBox::toggled,this,applyTheme);
+    dock->setWidget(panel);addDockWidget(Qt::LeftDockWidgetArea,dock);
+    resize(1280,820);
+}
+
+void MainWindow::saveStudioBackup() {
+    QMap<QString,QByteArray> overrides;
+    for(int i=0;i<ui->tabWidget->count();++i) {
+        auto* scroll=qobject_cast<QScrollArea*>(ui->tabWidget->widget(i));
+        auto* table=scroll?qobject_cast<FilterTable*>(scroll->widget()):nullptr;
+        if(!table)continue;
+        if(!table->flushPendingEdits()) {
+            QMessageBox::warning(this,tr("Backup"),tr("A plug-in has not supplied its current state. Close its panel and try again."));return;
+        }
+        const QString path=table->getConfigPath();
+        const QString relative=configDir.relativeFilePath(path);
+        if(path.isEmpty() || QDir::isAbsolutePath(relative) || relative==".." || relative.startsWith("../")) {
+            QMessageBox::warning(this,tr("Backup"),tr("Save all open configurations inside the configuration folder first:\n%1").arg(configDir.absolutePath()));return;
+        }
+        QStringList lines;
+        for(const auto& line:table->getLines())lines.append(line);
+        overrides.insert(relative,(lines.join("\r\n")+"\r\n").toUtf8());
+    }
+    const QString suggested=QDir::homePath()+"/DEISU-"+QDateTime::currentDateTime().toString("yyyyMMdd-HHmmss")+".eqbackup";
+    QString target=QFileDialog::getSaveFileName(this,tr("Save configuration backup"),suggested,tr("DEISU backup (*.eqbackup)"));
+    if(target.isEmpty())return;
+    if(!target.endsWith(".eqbackup",Qt::CaseInsensitive))target+=".eqbackup";
+    QString error;
+    if(!ConfigBackup::create(configDir.absolutePath(),target,overrides,error))QMessageBox::warning(this,tr("Backup failed"),error);
+    else QMessageBox::information(this,tr("Backup saved"),tr("Saved to:\n%1\n\nExternal files, plug-in binaries and licenses are not included.").arg(target));
+}
+
+void MainWindow::restoreStudioBackup() {
+    const QString archive=QFileDialog::getOpenFileName(this,tr("Open backup"),QDir::homePath(),tr("DEISU backup (*.eqbackup)"));
+    if(archive.isEmpty())return;
+    const QString parent=QFileDialog::getExistingDirectory(this,tr("Choose a parent folder for the restored copy"),QDir::homePath());
+    if(parent.isEmpty())return;
+    const QString target=parent+"/DEISU-restored-"+QDateTime::currentDateTime().toString("yyyyMMdd-HHmmss")+"-"+QUuid::createUuid().toString(QUuid::WithoutBraces).left(8);
+    QString error;
+    if(!ConfigBackup::restore(archive,target,error))QMessageBox::warning(this,tr("Restore failed"),error);
+    else QMessageBox::information(this,tr("Backup restored"),tr("Restored to:\n%1\n\nYour running configuration was not overwritten. To activate, copy the restored files into your configuration folder. External dependencies must still be present at their original paths.").arg(target));
+}
