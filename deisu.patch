@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "outproc/TransportProfile.h"
+#include <cassert>
+#include <limits>
+#include <iostream>
+// Exercise upstream timeline implementation too, with a portable allocator shim.
+#ifndef _WIN32
+#include <cstdlib>
+static void* _aligned_malloc(std::size_t n,std::size_t a) {void* p=nullptr;return posix_memalign(&p,a,n)==0?p:nullptr;}
+static void _aligned_free(void* p) {std::free(p);}
+#endif
+#define main upstreamContractsMain
+#include "SmokeTests/engine/realtime_tests.cpp"
+#undef main
+int main() {
+    using namespace EqApoTransport;
+    assert(parse(L"2")==2 && parse(L"5")==5 && parse(L"20")==20);
+    for(const auto* s:{L"",L"0",L"-1",L"NaN",L"2junk",L"9999999999"})assert(parse(s)==10);
+    assert(quantum(48000,64,2)==96);
+    assert(quantum(44100,64,2)==89);
+    assert(quantum(48000,480,2)==480); // callback lower bound
+    assert(quantum(48000,64,0)==480); // fallback
+    assert(quantum(std::numeric_limits<double>::quiet_NaN(),64,2)==64);
+    try {
+        testGraphAlignment();
+        for(unsigned rate:{44100u,48000u,96000u})
+            for(unsigned channels:{1u,2u,6u,8u})
+                for(unsigned ms:{2u,5u,10u,20u})
+                    for(unsigned callback:{64u,480u})
+                        for(unsigned pluginDelay:{0u,257u})
+                            testTimeline(channels,rate,quantum(rate,callback,ms),pluginDelay);
+        std::cout<<"PASS profiles: 96 transport layouts x 2 plugin delays; no callback allocations\n";
+        return 0;
+    } catch(const std::exception& e) {watch=false;std::cerr<<"FAIL "<<e.what()<<'\n';return 1;}
+}
