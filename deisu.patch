+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <QByteArray>
+#include <QString>
+#include <QMap>
+
+namespace ConfigBackup {
+// Snapshots include the config tree and saved plug-in states within its files.
+// External plug-in binaries, activations and files outside the tree are excluded.
+bool create(const QString& root, const QString& destination,
+            const QMap<QString,QByteArray>& overrides, QString& error);
+// Destination must not exist; publication is one directory rename after validation.
+bool restore(const QString& archive, const QString& destination, QString& error);
+}
