diff --git a/Deisu/tests/backup.cpp b/Deisu/tests/backup.cpp
new file mode 100644
index 0000000..76f127f
--- /dev/null
+++ b/Deisu/tests/backup.cpp
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "Editor/helpers/ConfigBackup.h"
+#include <QCoreApplication>
+#include <QTemporaryDir>
+#include <QDir>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonArray>
+#include <QtEndian>
+#include <stdexcept>
+#include <iostream>
+static void check(bool ok,const char* message) {if(!ok)throw std::runtime_error(message);}
+static void write(const QString& path,const QByteArray& bytes) {QFile f(path);check(f.open(QIODevice::WriteOnly),"open fixture");check(f.write(bytes)==bytes.size(),"write fixture");}
+static QByteArray read(const QString& path) {QFile f(path);check(f.open(QIODevice::ReadOnly),"read fixture");return f.readAll();}
+static QByteArray changedPath(QByteArray bytes,const QString& path) {
+    auto count=qFromBigEndian<quint32>(reinterpret_cast<const uchar*>(bytes.constData()+9));
+    auto object=QJsonDocument::fromJson(bytes.mid(13,count)).object();auto array=object["files"].toArray();
+    auto item=array[0].toObject();item["path"]=path;array[0]=item;object["files"]=array;
+    auto header=QJsonDocument(object).toJson(QJsonDocument::Compact);uchar size[4];qToBigEndian<quint32>(header.size(),size);
+    return bytes.left(9)+QByteArray(reinterpret_cast<char*>(size),4)+header+bytes.mid(13+count);
+}
+int main(int argc,char** argv) {
+ QCoreApplication app(argc,argv);
+ try {
+    QTemporaryDir temp;check(temp.isValid(),"temp");const auto root=temp.path()+"/config";QDir().mkpath(root+"/пресеты");
+    write(root+"/config.txt","Preamp: -3 dB\n");write(root+"/пресеты/state.bin",QByteArray("\0\xfftest",6));
+    QString error;const auto archive=temp.path()+"/test.eqbackup";
+    check(ConfigBackup::create(root,archive,{{"config.txt","Preamp: -6 dB\r\n"}},error),qPrintable(error));
+    const auto original=read(archive);const auto restored=temp.path()+"/restored";
+    check(ConfigBackup::restore(archive,restored,error),qPrintable(error));
+    check(read(restored+"/config.txt")=="Preamp: -6 dB\r\n","open-buffer snapshot");
+    check(read(restored+"/пресеты/state.bin")==read(root+"/пресеты/state.bin"),"binary/unicode round trip");
+    check(!ConfigBackup::restore(archive,restored,error),"existing destination must remain intact");
+    check(!ConfigBackup::create(root,root+"/recursive.eqbackup",{},error),"reject archive inside tree");
+    for(const auto& path:QStringList{"../escape","/absolute","C:/escape","foo\\bar","NUL.txt","a/../b","file:stream","x.","x "}) {
+        write(archive,changedPath(original,path));
+        check(!ConfigBackup::restore(archive,temp.path()+"/unsafe",error),"unsafe path rejected");
+        check(!QDir(temp.path()+"/unsafe").exists(),"no partial publication");
+    }
+    auto corrupt=original;corrupt[corrupt.size()-1]=char(corrupt.at(corrupt.size()-1)^1);write(archive,corrupt);
+    check(!ConfigBackup::restore(archive,temp.path()+"/corrupt",error),"checksum rejection");
+    check(!QDir(temp.path()+"/corrupt").exists(),"corruption rollback");
+    write(archive,original.left(original.size()-1));check(!ConfigBackup::restore(archive,temp.path()+"/truncated",error),"truncated payload");
+    write(archive,original+"x");check(!ConfigBackup::restore(archive,temp.path()+"/trailing",error),"trailing payload");
+#ifndef _WIN32
+    write(archive,original);write(root+"/CON.txt","bad");
+    check(!ConfigBackup::create(root,archive,{},error),"bad source name");check(read(archive)==original,"preserve previous backup on failure");
+#endif
+    std::cout<<"PASS backup: binary/unicode roundtrip, open snapshots, corruption, traversal, truncation, atomic restore and existing archive protection\n";
+    return 0;
+ } catch(const std::exception& e) {std::cerr<<"FAIL "<<e.what()<<'\n';return 1;}
+}
