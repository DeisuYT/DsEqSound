new file mode 100644
index 0000000..97cae54
--- /dev/null
+++ b/outproc/TransportProfile.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <string>
+
+namespace EqApoTransport {
+// Milliseconds per quantum; asynchronous transport uses two quanta.
+inline unsigned normalize(unsigned ms) noexcept {
+    return ms == 2 || ms == 5 || ms == 10 || ms == 20 ? ms : 10;
+}
+inline unsigned parse(const std::wstring& value) noexcept {
+    if (value == L"2") return 2;
+    if (value == L"5") return 5;
+    if (value == L"20") return 20;
+    return 10;
+}
+inline unsigned quantum(double rate, unsigned callbackFrames, unsigned ms) noexcept {
+    if (!std::isfinite(rate) || rate <= 0 || rate > 768000) return callbackFrames;
+    return (std::max)(callbackFrames, static_cast<unsigned>(std::ceil(rate * normalize(ms) / 1000.0)));
+}
+}
