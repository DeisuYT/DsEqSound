diff --git a/Editor/helpers/ConfigBackup.cpp b/Editor/helpers/ConfigBackup.cpp
new file mode 100644
index 0000000..f48d4fd
--- /dev/null
+++ b/Editor/helpers/ConfigBackup.cpp
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "ConfigBackup.h"
+#include <QCryptographicHash>
+#include <QDateTime>
+#include <QDir>
+#include <QDirIterator>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+#include <QSaveFile>
+#include <QSet>
+#include <QTemporaryDir>
+#include <QtEndian>
+#include <algorithm>
+
+namespace {
+constexpr qint64 maxTotal=2LL*1024*1024*1024;
+constexpr qint64 maxFile=256LL*1024*1024;
+constexpr quint32 maxHeader=4*1024*1024;
+constexpr int maxEntries=10000;
+const QByteArray magic("DEISUBAK\x01",9);
+struct Entry {QString path; qint64 size; QByteArray hash;};
+bool fail(QString& error,const QString& text) {error=text;return false;}
+bool safePath(const QString& path) {
+    if(path.isEmpty() || path.size()>1024 || path.contains('\\') || path.startsWith('/'))return false;
+    static const QRegularExpression bad(QStringLiteral("[<>:\"|?*\\x00-\\x1f]"));
+    static const QRegularExpression reserved(QStringLiteral("^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\\.|$)"),QRegularExpression::CaseInsensitiveOption);
+    for(const QString& part:path.split('/'))
+        if(part.isEmpty() || part=="." || part==".." || part.endsWith('.') || part.endsWith(' ') ||
+           part.contains(bad) || reserved.match(part).hasMatch())return false;
+    return true;
+}
+bool transfer(QIODevice& source,QIODevice* dest,qint64 size,QByteArray& hash) {
+    QCryptographicHash sha(QCryptographicHash::Sha256);
+    while(size>0) {
+        const QByteArray block=source.read((std::min)(size,qint64(65536)));
+        if(block.isEmpty())return false;
+        if(dest && dest->write(block)!=block.size())return false;
+        sha.addData(block);size-=block.size();
+    }
+    hash=sha.result().toHex();return true;
+}
+bool readIndex(QFile& file,QList<Entry>& entries,QString& error) {
+    if(file.read(magic.size())!=magic)return fail(error,"Not a DEISU backup (or unsupported version).");
+    const QByteArray length=file.read(4);
+    if(length.size()!=4)return fail(error,"Truncated backup.");
+    const quint32 count=qFromBigEndian<quint32>(reinterpret_cast<const uchar*>(length.constData()));
+    if(!count || count>maxHeader)return fail(error,"Invalid backup header size.");
+    const QByteArray header=file.read(count);
+    if(header.size()!=count)return fail(error,"Truncated backup header.");
+    QJsonParseError parse;
+    const auto doc=QJsonDocument::fromJson(header,&parse);
+    if(parse.error!=QJsonParseError::NoError || !doc.isObject())return fail(error,"Invalid backup manifest.");
+    const auto object=doc.object();
+    if(object.value("format").toString()!="deisu-config-1" || !object.value("files").isArray())return fail(error,"Unsupported backup format.");
+    const auto files=object.value("files").toArray();
+    if(files.isEmpty() || files.size()>maxEntries)return fail(error,"Invalid file count.");
+    QSet<QString> paths; qint64 total=0;
+    for(const auto value:files) {
+        const auto item=value.toObject();
+        const QString path=item.value("path").toString();
+        const double number=item.value("size").toDouble(-1);
+        const auto hash=item.value("sha256").toString().toLatin1();
+        if(!safePath(path) || paths.contains(path.toCaseFolded()) || number<0 || number>maxFile ||
+           number!=qint64(number) || hash.size()!=64 || QByteArray::fromHex(hash).toHex()!=hash)
+            return fail(error,"Unsafe or invalid backup entry.");
+        paths.insert(path.toCaseFolded());total+=qint64(number);
+        if(total>maxTotal)return fail(error,"Backup exceeds the 2 GiB limit.");
+        entries.append({path,qint64(number),hash});
+    }
+    for(const auto& entry:entries) {
+        QString parent=entry.path;
+        while(parent.contains('/')) {
+            parent=parent.left(parent.lastIndexOf('/'));
+            if(paths.contains(parent.toCaseFolded()))return fail(error,"Conflicting backup paths.");
+        }
+    }
+    if(file.size()-file.pos()!=total)return fail(error,"Truncated backup or unexpected trailing data.");
+    return true;
+}
+}
+
+bool ConfigBackup::create(const QString& root,const QString& destination,
+                         const QMap<QString,QByteArray>& overrides,QString& error) {
+    const QDir dir(root);
+    if(!dir.exists())return fail(error,"Configuration folder does not exist.");
+    const QString canonical=QFileInfo(root).canonicalFilePath();
+    const QString dest=QFileInfo(destination).absoluteFilePath();
+    // Keep the archive outside the tree to avoid recursion and accidental overwrites.
+    const QString relativeDestination=dir.relativeFilePath(dest);
+    if(safePath(relativeDestination))return fail(error,"Choose a backup destination outside the configuration folder.");
+    QMap<QString,QString> sources;
+    QDirIterator it(canonical,QDir::Files|QDir::Dirs|QDir::NoDotAndDotDot|QDir::Hidden|QDir::System,QDirIterator::Subdirectories);
+    while(it.hasNext()) {
+        it.next();const auto info=it.fileInfo();
+        if(info.isSymLink())return fail(error,"Symbolic links are not supported: "+info.filePath());
+        if(info.isDir())continue;
+        if(!info.isFile())return fail(error,"Non-regular file: "+info.filePath());
+        const QString relative=QDir(canonical).relativeFilePath(info.filePath());
+        if(relative.endsWith(".eqbackup",Qt::CaseInsensitive))continue;
+        if(!safePath(relative))return fail(error,"Unsupported file name: "+relative);
+        sources.insert(relative,info.filePath());
+        if(sources.size()>maxEntries)return fail(error,"Too many files.");
+    }
+    for(auto item=overrides.cbegin();item!=overrides.cend();++item) {
+        if(!safePath(item.key()))return fail(error,"An open configuration is outside the configuration folder.");
+        sources.insert(item.key(),QString());
+    }
+    if(sources.isEmpty() || sources.size()>maxEntries)return fail(error,"Empty or oversized configuration tree.");
+    QList<Entry> entries;QJsonArray manifest;QSet<QString> names;qint64 total=0;
+    for(auto item=sources.cbegin();item!=sources.cend();++item) {
+        if(names.contains(item.key().toCaseFolded()))return fail(error,"Case-colliding file names.");
+        names.insert(item.key().toCaseFolded());
+        QByteArray hash;qint64 size=0;
+        if(overrides.contains(item.key())) {
+            const auto bytes=overrides.value(item.key());size=bytes.size();
+            hash=QCryptographicHash::hash(bytes,QCryptographicHash::Sha256).toHex();
+        } else {
+            QFile input(item.value());
+            if(!input.open(QIODevice::ReadOnly))return fail(error,input.errorString());
+            size=input.size();
+            if(size>maxFile)return fail(error,"File exceeds 256 MiB: "+item.key());
+            if(!transfer(input,nullptr,size,hash))return fail(error,"Cannot read: "+item.key());
+        }
+        total+=size;
+        if(size>maxFile || total>maxTotal)return fail(error,"Backup exceeds size limits.");
+        entries.append({item.key(),size,hash});
+        manifest.append(QJsonObject{{"path",item.key()},{"size",double(size)},{"sha256",QString::fromLatin1(hash)}});
+    }
+    const auto header=QJsonDocument(QJsonObject{{"format","deisu-config-1"},
+        {"createdUtc",QDateTime::currentDateTimeUtc().toString(Qt::ISODate)},
+        {"scope","config-tree; external files, binaries and licenses excluded"},{"files",manifest}}).toJson(QJsonDocument::Compact);
+    if(header.size()>maxHeader)return fail(error,"Backup index is too large.");
+    QSaveFile output(destination); // Atomic commit, no fallback that could destroy an existing archive.
+    if(!output.open(QIODevice::WriteOnly))return fail(error,output.errorString());
+    uchar length[4];qToBigEndian<quint32>(quint32(header.size()),length);
+    if(output.write(magic)!=magic.size() || output.write(reinterpret_cast<char*>(length),4)!=4 || output.write(header)!=header.size())
+        return fail(error,"Cannot write backup header.");
+    for(const auto& entry:entries) {
+        if(overrides.contains(entry.path)) {
+            const auto bytes=overrides.value(entry.path);
+            if(output.write(bytes)!=bytes.size())return fail(error,output.errorString());
+        } else {
+            QFile input(sources.value(entry.path));QByteArray hash;
+            if(!input.open(QIODevice::ReadOnly) || input.size()!=entry.size || !transfer(input,&output,entry.size,hash) || hash!=entry.hash)
+                return fail(error,"File changed or could not be copied: "+entry.path);
+        }
+    }
+    if(!output.commit())return fail(error,output.errorString());
+    return true;
+}
+
+bool ConfigBackup::restore(const QString& archive,const QString& destination,QString& error) {
+    QFile file(archive);
+    if(!file.open(QIODevice::ReadOnly))return fail(error,file.errorString());
+    QList<Entry> entries;
+    if(!readIndex(file,entries,error))return false;
+    const QFileInfo target(destination);
+    if(target.exists() || target.isSymLink())return fail(error,"Restore destination must be a new folder.");
+    const QString parent=target.dir().canonicalPath();
+    if(parent.isEmpty())return fail(error,"Restore parent folder does not exist.");
+    QTemporaryDir stage(parent+"/.deisu-restore-XXXXXX");
+    if(!stage.isValid())return fail(error,"Cannot create staging folder.");
+    for(const auto& entry:entries) {
+        const QString path=stage.path()+"/"+entry.path;
+        if(!QDir().mkpath(QFileInfo(path).absolutePath()))return fail(error,"Cannot create restored subfolder.");
+        QFile output(path);QByteArray hash;
+        if(!output.open(QIODevice::WriteOnly|QIODevice::NewOnly) || !transfer(file,&output,entry.size,hash) || !output.flush() || hash!=entry.hash)
+            return fail(error,"Corrupt backup or write failure: "+entry.path);
+    }
+    if(!QDir().rename(stage.path(),target.absoluteFilePath()))return fail(error,"Cannot publish restored folder (destination may already exist).");
+    stage.setAutoRemove(false);
+    return true;
+}
